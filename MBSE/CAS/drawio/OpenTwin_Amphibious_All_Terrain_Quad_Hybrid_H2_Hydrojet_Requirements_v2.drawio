<mxfile host="app.diagrams.net" modified="2026-09-09T02:51:33.033225+00:00" agent="ChatGPT" version="31.4.2" type="device">
<diagram id="452fecd17ea0" name="01 - Scope &amp; CONOPS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious All-Terrain Quad — High-Level Requirements Engineering — Hybrid H2-Electric / Hydrojet Revision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;System Concept&lt;/b&gt;&lt;br&gt;Compact four-wheel amphibious all-terrain vehicle capable of controlled operation on land and calm/inland water, represented by an OpenTwin digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="220" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Primary Use Cases&lt;/b&gt;&lt;br&gt;• Rural mobility research&lt;br&gt;• Ecotourism / recreation concept&lt;br&gt;• Farm / estate mobility&lt;br&gt;• Inspection and environmental monitoring&lt;br&gt;• Amphibious robotics/autonomy research platform" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="585" y="140" width="430" height="220" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Stakeholders&lt;/b&gt;&lt;br&gt;Operator/rider&lt;br&gt;Mechanical &amp; marine engineers&lt;br&gt;Electrical/control engineers&lt;br&gt;OpenTwin/software team&lt;br&gt;Maintenance staff&lt;br&gt;Test engineers&lt;br&gt;Applicable regulatory authorities" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1100" y="140" width="430" height="220" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;System Boundary&lt;/b&gt;&lt;br&gt;IN: chassis, buoyant body, wheels/tires, steering, braking, land/water propulsion, energy/fuel system, controls, sensors, HMI, OpenTwin gateway.&lt;br&gt;&lt;br&gt;OUT: detailed production drawings, certification, public-road or navigational approval." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="450" width="700" height="270" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Operational Modes&lt;/b&gt;&lt;br&gt;OFF / SAFE&lt;br&gt;LAND DRIVE&lt;br&gt;WATER DRIVE&lt;br&gt;TRANSITION LAND→WATER&lt;br&gt;TRANSITION WATER→LAND&lt;br&gt;DEGRADED / LIMP&lt;br&gt;MAINTENANCE / DIAGNOSTIC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="450" width="700" height="270" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Concept Gate&lt;/b&gt;&lt;br&gt;Amphibious operation shall proceed from simulation to controlled prototype testing. Stability, flotation, ingress protection, propulsion guarding, emergency recovery and applicable vehicle/marine requirements require qualified engineering validation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="790" width="1100" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="830c786a019b" name="02 - Functional Requirements"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="FR-01" value="&lt;b&gt;FR-01 — Land Mobility&lt;/b&gt;&lt;br&gt;Provide controlled propulsion, steering and braking on the defined off-road terrain envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-02" value="&lt;b&gt;FR-02 — Water Mobility&lt;/b&gt;&lt;br&gt;Provide controlled low-speed propulsion and directional control on the defined water envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-03" value="&lt;b&gt;FR-03 — Transition&lt;/b&gt;&lt;br&gt;Support defined land-to-water and water-to-land transition sequences." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-04" value="&lt;b&gt;FR-04 — Buoyancy&lt;/b&gt;&lt;br&gt;Maintain required positive buoyancy and reserve buoyancy under the validated loading condition." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-05" value="&lt;b&gt;FR-05 — Stability&lt;/b&gt;&lt;br&gt;Maintain validated static/dynamic stability margins in land and water modes." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-06" value="&lt;b&gt;FR-06 — Ingress Control&lt;/b&gt;&lt;br&gt;Protect safety-critical electrical, energy and control components against expected water/dust exposure." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-07" value="&lt;b&gt;FR-07 — Propulsion Interlock&lt;/b&gt;&lt;br&gt;Prevent incompatible propulsion states during mode transitions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-08" value="&lt;b&gt;FR-08 — Operator HMI&lt;/b&gt;&lt;br&gt;Display mode, speed, energy/fuel state, faults, water-related warnings and OpenTwin status." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-09" value="&lt;b&gt;FR-09 — Emergency State&lt;/b&gt;&lt;br&gt;Provide an operator-accessible means to command a safe/de-energized state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-10" value="&lt;b&gt;FR-10 — Telemetry&lt;/b&gt;&lt;br&gt;Publish selected speed, orientation, energy, temperature, mode, fault and environment states." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-11" value="&lt;b&gt;FR-11 — Configuration&lt;/b&gt;&lt;br&gt;Track installed propulsion, controller, firmware, sensor and vehicle configuration." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="FR-12" value="&lt;b&gt;FR-12 — Diagnostics&lt;/b&gt;&lt;br&gt;Record faults, transition events, maintenance indicators and verification data." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c02a08335919" name="03 - NFR &amp; Constraints"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Non-Functional Requirements &amp; Constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;NFR-01 Safety&lt;/b&gt;&lt;br&gt;Safety-critical functions shall fail to a defined state; hazardous rotating/hot/electrical elements shall be guarded or isolated." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;NFR-02 Structural&lt;/b&gt;&lt;br&gt;Frame, suspension, body and attachment points shall be verified against the defined mass and load cases." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;NFR-03 Marine Stability&lt;/b&gt;&lt;br&gt;Flotation, freeboard and stability shall be analytically assessed and prototype-validated for the intended operating envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;NFR-04 Environmental&lt;/b&gt;&lt;br&gt;Components shall have environmental protection appropriate to immersion/splash, mud, dust, vibration, temperature and corrosion exposure." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;NFR-05 Human Factors&lt;/b&gt;&lt;br&gt;Controls shall remain distinguishable and operable in both land and water modes; critical warnings shall be conspicuous." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;NFR-06 Maintainability&lt;/b&gt;&lt;br&gt;Service items, drains, seals, propulsion components and electronics shall be inspectable and replaceable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;NFR-07 Modularity&lt;/b&gt;&lt;br&gt;Propulsion, energy, sensing, compute and communications should use documented replaceable interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;NFR-08 Cybersecurity&lt;/b&gt;&lt;br&gt;Remote interfaces shall use authentication, protected credentials and least privilege." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;NFR-09 Offline Operation&lt;/b&gt;&lt;br&gt;Loss of remote connectivity shall not prevent essential local control." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;NFR-10 Data Provenance&lt;/b&gt;&lt;br&gt;Twin data shall preserve timestamp, configuration, source and quality metadata." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;NFR-11 Sustainability&lt;/b&gt;&lt;br&gt;Prefer repairable modules, recyclable materials and efficient propulsion/energy systems." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;NFR-12 Compliance&lt;/b&gt;&lt;br&gt;Prototype requirements shall be mapped to applicable local vehicle, watercraft, electrical and environmental rules before field deployment." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c14427944382" name="04 - Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Amphibious ATV — High-Level Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="mech" value="&lt;b&gt;STRUCTURE &amp; MOBILITY&lt;/b&gt;&lt;br&gt;Frame/body&lt;br&gt;Suspension&lt;br&gt;Wheels/tires&lt;br&gt;Steering&lt;br&gt;Brakes&lt;br&gt;Buoyant volumes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="160" width="280" height="250" as="geometry" /></mxCell><mxCell id="prop" value="&lt;b&gt;DUAL-ENVIRONMENT PROPULSION&lt;/b&gt;&lt;br&gt;Land drive&lt;br&gt;Water propulsion&lt;br&gt;Mode selector&lt;br&gt;Propulsion interlocks&lt;br&gt;Cooling / sealing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="160" width="280" height="250" as="geometry" /></mxCell><mxCell id="ctrl" value="&lt;b&gt;CONTROL &amp; ENERGY&lt;/b&gt;&lt;br&gt;Vehicle controller&lt;br&gt;Energy/fuel subsystem&lt;br&gt;Power distribution&lt;br&gt;Safety I/O&lt;br&gt;Diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="720" y="160" width="280" height="250" as="geometry" /></mxCell><mxCell id="sens" value="&lt;b&gt;SENSING&lt;/b&gt;&lt;br&gt;Wheel/shaft speed&lt;br&gt;IMU / attitude&lt;br&gt;Temperature&lt;br&gt;Energy state&lt;br&gt;Ingress/leak sensing&lt;br&gt;GNSS optional" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1050" y="160" width="280" height="250" as="geometry" /></mxCell><mxCell id="edge" value="&lt;b&gt;OPENTWIN EDGE&lt;/b&gt;&lt;br&gt;State estimator&lt;br&gt;Mode/state machine&lt;br&gt;Telemetry adapter&lt;br&gt;Event buffer&lt;br&gt;Configuration ID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1050" y="550" width="280" height="250" as="geometry" /></mxCell><mxCell id="twin" value="&lt;b&gt;DIGITAL TWIN&lt;/b&gt;&lt;br&gt;Vehicle Twin&lt;br&gt;Propulsion Twin&lt;br&gt;Energy Twin&lt;br&gt;Mobility Twin&lt;br&gt;Environment Twin&lt;br&gt;Maintenance Twin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="720" y="550" width="280" height="250" as="geometry" /></mxCell><mxCell id="sim" value="&lt;b&gt;SIMULATION / MBSE&lt;/b&gt;&lt;br&gt;Requirements&lt;br&gt;Multibody dynamics&lt;br&gt;Hydrodynamic abstraction&lt;br&gt;Energy model&lt;br&gt;Control model&lt;br&gt;MIL/SIL/HIL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="550" width="280" height="250" as="geometry" /></mxCell><mxCell id="hmi" value="&lt;b&gt;OPERATOR / TEST HMI&lt;/b&gt;&lt;br&gt;Mode&lt;br&gt;Speed&lt;br&gt;Attitude&lt;br&gt;Energy&lt;br&gt;Warnings&lt;br&gt;Diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="550" width="280" height="250" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="mech" target="prop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="prop" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ctrl" target="sens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sens" target="edge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="edge" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="sim" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="twin" target="hmi"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="caa3a169b2b6" name="05 - Modes &amp; Safety"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Operating State Model &amp; Safety Interlocks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="off" value="&lt;b&gt;OFF / SAFE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="100" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="land" value="&lt;b&gt;LAND DRIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="180" width="250" height="100" as="geometry" /></mxCell><mxCell id="trans1" value="&lt;b&gt;LAND → WATER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="760" y="180" width="250" height="100" as="geometry" /></mxCell><mxCell id="water" value="&lt;b&gt;WATER DRIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1100" y="380" width="250" height="100" as="geometry" /></mxCell><mxCell id="trans2" value="&lt;b&gt;WATER → LAND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="760" y="600" width="250" height="100" as="geometry" /></mxCell><mxCell id="maint" value="&lt;b&gt;MAINTENANCE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="420" y="600" width="250" height="100" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;Transition guards (high level)&lt;/b&gt;&lt;br&gt;• Mode changes require validated speed/condition thresholds.&lt;br&gt;• Propulsion commands shall be mutually compatible with active mode.&lt;br&gt;• Critical ingress, thermal, energy or control faults shall inhibit unsafe transitions.&lt;br&gt;• Maintenance mode shall inhibit normal propulsion unless a controlled test procedure explicitly enables it.&lt;br&gt;• Exact thresholds are TBD by engineering analysis and prototype validation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="390" y="790" width="900" height="150" as="geometry" /></mxCell><mxCell id="a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="off" target="land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="trans1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="trans1" target="water"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="water" target="trans2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="trans2" target="land"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="land" target="off"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="off" target="maint"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="367851e0859f" name="06 - Interfaces &amp; Twin Data"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Interfaces &amp; OpenTwin Data Model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="i0" value="&lt;b&gt;IF-01 Mechanical&lt;/b&gt;&lt;br&gt;Frame ↔ suspension ↔ wheel modules; sealed body interfaces; service access." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i1" value="&lt;b&gt;IF-02 Propulsion&lt;/b&gt;&lt;br&gt;Controller ↔ land drive and water propulsion; guarded energy transfer and mode interlocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="160" as="geometry" /></mxCell><mxCell id="i2" value="&lt;b&gt;IF-03 Electrical&lt;/b&gt;&lt;br&gt;Energy source, protected distribution, low-voltage control, sensors and communications." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i3" value="&lt;b&gt;IF-04 Data&lt;/b&gt;&lt;br&gt;Documented vehicle bus / IP adapters; timestamped telemetry; local buffering." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="335" width="690" height="160" as="geometry" /></mxCell><mxCell id="i4" value="&lt;b&gt;IF-05 Human&lt;/b&gt;&lt;br&gt;Steering, throttle, brake, mode selection, emergency control, warnings and diagnostics." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="i5" value="&lt;b&gt;IF-06 Environment&lt;/b&gt;&lt;br&gt;Tire/terrain contact, water forces, splash/immersion boundary, thermal and corrosion exposure." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="540" width="690" height="160" as="geometry" /></mxCell><mxCell id="schema" value="&lt;b&gt;Minimum OpenTwin state&lt;/b&gt;&lt;br&gt;asset_id · configuration_id · operating_mode · land_speed · water_speed · attitude · propulsion_state · energy_state · temperatures · ingress_status · fault_state · maintenance_due · software_version · timestamp · provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="330" y="770" width="940" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="7ab2863e2df5" name="07 - V&amp;V Traceability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Verification &amp; Validation Strategy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="v0" value="&lt;b&gt;V-01 Inspection&lt;/b&gt;&lt;br&gt;Guards, sealing, access, controls, labels, flotation compartments and serviceability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="690" height="145" as="geometry" /></mxCell><mxCell id="v1" value="&lt;b&gt;V-02 Analysis&lt;/b&gt;&lt;br&gt;Mass/CG, structural loads, suspension loads, buoyancy, freeboard, stability, energy/thermal budgets." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="120" width="690" height="145" as="geometry" /></mxCell><mxCell id="v2" value="&lt;b&gt;V-03 Simulation&lt;/b&gt;&lt;br&gt;Land dynamics, transition logic, simplified hydrodynamics, controller MIL/SIL and fault scenarios." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="305" width="690" height="145" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;V-04 Bench Test&lt;/b&gt;&lt;br&gt;Power distribution, controllers, sensors, interlocks, ingress detection, communications and emergency state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="305" width="690" height="145" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;V-05 Controlled Land Test&lt;/b&gt;&lt;br&gt;Low-speed handling, braking, steering, terrain response and thermal behavior in a closed test environment." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="490" width="690" height="145" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;V-06 Controlled Water Test&lt;/b&gt;&lt;br&gt;Tethered/controlled flotation, stability, propulsion, steering and recovery before progressively expanding the test envelope." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="490" width="690" height="145" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;V-07 Transition Test&lt;/b&gt;&lt;br&gt;Controlled shoreline/ramp transition after land and water modes independently satisfy entry criteria." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="675" width="690" height="145" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;V-08 Digital Twin V&amp;V&lt;/b&gt;&lt;br&gt;State consistency, event ordering, configuration traceability, offline recovery and telemetry quality." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="825" y="675" width="690" height="145" as="geometry" /></mxCell><mxCell id="trace" value="&lt;b&gt;Traceability:&lt;/b&gt; Stakeholder Need → System Requirement → Subsystem Requirement → Design Element → Verification Method → Evidence → Configuration Baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="250" y="870" width="1100" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="d729ec63e6df" name="08 - MVP &amp; Roadmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="MVP Baseline &amp; Engineering Roadmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry" /></mxCell><mxCell id="mvp" value="&lt;b&gt;MVP / Technology Demonstrator&lt;/b&gt;&lt;br&gt;• Simplified amphibious chassis/body&lt;br&gt;• Four-wheel land mobility&lt;br&gt;• Low-speed water propulsion concept&lt;br&gt;• Manual steering/control&lt;br&gt;• Safe mode transition logic&lt;br&gt;• Energy + temperature monitoring&lt;br&gt;• IMU and speed sensing&lt;br&gt;• Ingress/leak detection&lt;br&gt;• OpenTwin edge gateway&lt;br&gt;• Telemetry + event history&lt;br&gt;• Controlled test instrumentation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="550" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1 — Requirements / MBSE&lt;/b&gt;&lt;br&gt;CONOPS&lt;br&gt;Hazards&lt;br&gt;Operational envelope&lt;br&gt;Requirements baseline&lt;br&gt;Regulatory mapping" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="140" width="380" height="210" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2 — Digital Engineering&lt;/b&gt;&lt;br&gt;CAD packaging&lt;br&gt;Mass/CG model&lt;br&gt;Land dynamics&lt;br&gt;Buoyancy/stability model&lt;br&gt;Control simulation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="140" width="380" height="210" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3 — Subsystem Prototypes&lt;/b&gt;&lt;br&gt;Land mobility rig&lt;br&gt;Buoyant body mock-up&lt;br&gt;Water propulsion rig&lt;br&gt;Controller/HIL&lt;br&gt;OpenTwin integration" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="420" width="380" height="230" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4 — Integrated Demonstrator&lt;/b&gt;&lt;br&gt;Closed-course land test&lt;br&gt;Controlled flotation test&lt;br&gt;Controlled water test&lt;br&gt;Transition test&lt;br&gt;Requirements evidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="420" width="380" height="230" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;Release Gate&lt;/b&gt;&lt;br&gt;No expansion to public-road, navigable-water or passenger/commercial operation until applicable structural, flotation/stability, electrical, environmental, safety and legal requirements are independently reviewed and satisfied." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="430" y="770" width="980" height="120" as="geometry" /></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p4" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="7c589b5747dc" name="09 - Hybrid H2-Electric &amp; Hydrojet"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="OpenTwin Hybrid Hydrogen-Electric Propulsion &amp; Mini Hydrojet — High-Level Requirements" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="25" width="1280" height="70" as="geometry" /></mxCell><mxCell id="arch" value="&lt;b&gt;Propulsion Architecture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hydrogen storage / supply → fuel-cell or H2 energy-conversion module → protected DC bus → wheel-hub electric motors for land propulsion + electrically driven mini hydrojet for water propulsion.&lt;br&gt;&lt;br&gt;The architecture shall support modular replacement of energy-conversion and propulsion subsystems." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="470" height="260" as="geometry" /></mxCell><mxCell id="h2" value="&lt;b&gt;Hydrogen Subsystem — H2-REQ&lt;/b&gt;&lt;br&gt;H2-001 Hydrogen storage and delivery shall use purpose-designed rated components.&lt;br&gt;H2-002 The system shall include isolation, pressure regulation, leak detection and ventilation strategy.&lt;br&gt;H2-003 Hydrogen hardware shall be physically segregated from ignition sources and hot surfaces where practicable.&lt;br&gt;H2-004 Emergency shutdown shall isolate hydrogen flow independently of cloud or remote services.&lt;br&gt;H2-005 Refueling/servicing interfaces shall be clearly identified and access-controlled." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="585" y="130" width="460" height="310" as="geometry" /></mxCell><mxCell id="elec" value="&lt;b&gt;Electric Traction — ELEC-REQ&lt;/b&gt;&lt;br&gt;ELEC-001 Each driven wheel may use an independent hub motor with torque command and status feedback.&lt;br&gt;ELEC-002 Traction control shall limit commanded torque during low-grip, transition and degraded conditions.&lt;br&gt;ELEC-003 The DC bus shall include isolation, overcurrent protection, pre-charge and fault monitoring as applicable.&lt;br&gt;ELEC-004 Regenerative braking may be supported if compatible with stability and energy-system constraints.&lt;br&gt;ELEC-005 Critical propulsion faults shall trigger a defined safe/degraded state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="440" height="310" as="geometry" /></mxCell><mxCell id="jet" value="&lt;b&gt;Mini Hydrojet — HJ-REQ&lt;/b&gt;&lt;br&gt;HJ-001 Water propulsion shall use a compact guarded hydrojet or equivalent enclosed water-thrust module.&lt;br&gt;HJ-002 Intake/outlet geometry shall reduce accidental contact with moving elements.&lt;br&gt;HJ-003 Hydrojet enable shall be interlocked with WATER DRIVE or approved transition state.&lt;br&gt;HJ-004 The system shall monitor hydrojet speed/current/temperature or equivalent health indicators.&lt;br&gt;HJ-005 Intake blockage or abnormal load shall generate an alert and bounded shutdown/degraded response." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="470" height="310" as="geometry" /></mxCell><mxCell id="control" value="&lt;b&gt;Supervisory Energy &amp; Mode Control&lt;/b&gt;&lt;br&gt;CTRL-001 A supervisory controller shall coordinate hydrogen energy conversion, DC bus, wheel motors and hydrojet.&lt;br&gt;CTRL-002 LAND DRIVE shall prioritize wheel traction and inhibit normal hydrojet thrust.&lt;br&gt;CTRL-003 WATER DRIVE shall prioritize hydrojet thrust and constrain wheel-motor behavior to the validated strategy.&lt;br&gt;CTRL-004 Transition modes shall enforce speed, attitude, ingress and energy preconditions.&lt;br&gt;CTRL-005 Safety interlocks shall remain local and deterministic." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="585" y="500" width="460" height="310" as="geometry" /></mxCell><mxCell id="twin" value="&lt;b&gt;OpenTwin Hybrid Propulsion Twin&lt;/b&gt;&lt;br&gt;Twin state should include:&lt;br&gt;• H2 pressure / isolation state&lt;br&gt;• leak detector status&lt;br&gt;• fuel-cell / conversion-module state&lt;br&gt;• DC bus voltage/current&lt;br&gt;• wheel-motor torque/speed/temperature&lt;br&gt;• hydrojet status/current/temperature&lt;br&gt;• operating mode&lt;br&gt;• energy reserve&lt;br&gt;• faults / maintenance due&lt;br&gt;• software/configuration version&lt;br&gt;&lt;br&gt;All telemetry shall include timestamp, source, quality and provenance metadata." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="440" height="310" as="geometry" /></mxCell><mxCell id="vv" value="&lt;b&gt;Verification &amp; Safety Gates&lt;/b&gt;&lt;br&gt;Analysis: hydrogen inventory, ventilation, thermal loads, electrical fault energy, mass/CG, propulsion sizing.&lt;br&gt;Bench tests: leak detection, isolation, pre-charge, motor controls, hydrojet current/thermal protection, interlocks.&lt;br&gt;Controlled prototype tests: low-energy land traction, static water-thrust test, progressive water trial, transition test.&lt;br&gt;Jurisdiction-specific hydrogen, electrical, vehicle and watercraft requirements must be identified before field release." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="880" width="1000" height="170" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="arch" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h2" target="elec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="elec" target="control"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="control" target="jet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="control" target="twin"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>