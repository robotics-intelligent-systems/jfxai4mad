<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.4.2" type="device">
  <diagram id="p0" name="01 · Requisitos de alto nivel">
    <mxGraphModel dx="1800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SUMERGIBLE DEPORTIVO HIDROJET | Ingeniería de requisitos&#10;Especificación conceptual de alto nivel · Revisión A · Basada en la imagen suministrada" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1720" height="85" />
        </mxCell>
        <mxCell id="basis" value="BASE OBSERVADA&#10;Carenado hidrodinámico, cubierta transparente, dos asientos en tándem, aletas, módulo de energía y hidrojet posterior.&#10;La ilustración no demuestra casco resistente, soporte vital ni mecanismo de recuperación." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="145" width="840" height="140" />
        </mxCell>
        <mxCell id="open" value="ALCANCE POR CONFIRMAR&#10;D-01: misión y límites. D-02: cabina seca y régimen de presión. D-03: mecanismo de inmersión y recuperación. D-04: energía. D-05: jurisdicción, categoría y base de conformidad.&#10;TBD: por definir · TBC: por confirmar." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="145" width="850" height="140" />
        </mxCell>
        <mxCell id="sys" value="SYS-00 · SISTEMA DE INTERÉS&#10;El sistema deberá ejecutar la misión acuática aprobada, integrando propulsión, flotabilidad, habitabilidad, control y recuperación dentro de una envolvente demostrada." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="320" width="920" height="110" />
        </mxCell>
        <mxCell id="r1" value="R-01 · MISIÓN Y ENVOLVENTE&#10;Deberá definir y limitar operación en superficie, transición e inmersión según una misión aprobada.&#10;Ocupantes, carga [kg], profundidad [m], duración [min], velocidad [m/s], oleaje y corriente: TBD.&#10;Verificación: V-01 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r2" value="R-02 · ESTRUCTURA RESISTENTE Y CIERRES&#10;Deberá mantener la integridad del volumen ocupado y cierres frente a las cargas y presión de la envolvente aprobada.&#10;Arquitectura de presión, materiales, cargas, fatiga, sellos y margen: TBD. El carenado no equivale al casco resistente.&#10;Verificación: V-02 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r3" value="R-03 · FLOTABILIDAD Y ESTABILIDAD&#10;Deberá mantener estabilidad y condiciones de flotación controladas para los estados de carga y modos definidos.&#10;Masa, CG, centro de flotación, reserva, trimado y principio de inmersión: TBD.&#10;Verificación: V-03 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r4" value="R-04 · PROPULSIÓN HIDROJET&#10;Deberá proporcionar empuje y respuesta de maniobra compatibles con la misión, protegiendo las zonas de admisión y descarga.&#10;Empuje [N], potencia [kW], caudal, rendimiento, ruido y límites de operación: TBD.&#10;Verificación: V-04 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r5" value="R-05 · ENERGÍA Y GESTIÓN TÉRMICA&#10;Deberá suministrar energía para la misión y reserva de emergencia con supervisión térmica y aislamiento de fallos.&#10;Batería eléctrica: opción conceptual; química, capacidad [kWh], reserva y límites térmicos: TBD.&#10;Verificación: V-05 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r6" value="R-06 · CONTROL Y NAVEGACIÓN&#10;Deberá permitir mando, estimación de estado y transición entre modos dentro de límites supervisados.&#10;Sensores, profundidad, actitud, velocidades, alarmas, latencia y autoridad de mando: TBD.&#10;Verificación: V-06 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r7" value="R-07 · HABITABILIDAD Y ATMÓSFERA&#10;Deberá mantener condiciones habitables en el volumen ocupado durante la misión y contingencias aprobadas.&#10;Cabina seca: hipótesis a confirmar; presión, O₂, CO₂, temperatura, humedad y duración de reserva: TBD.&#10;Verificación: V-07 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r8" value="R-08 · EMERGENCIA Y RECUPERACIÓN&#10;Deberá proporcionar una estrategia verificable de retorno a superficie y recuperación ante los fallos definidos.&#10;Pérdida de energía/control, entrada de agua, incendio, atrapamiento y rescate: casos a analizar.&#10;Verificación: V-08 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r9" value="R-09 · ACCESO Y FACTORES HUMANOS&#10;Deberá permitir embarque, visibilidad, sujeción y salida según los escenarios autorizados y la población usuaria.&#10;Dos asientos en tándem observados; ocupación, ergonomía, cierres y evacuación: TBC/TBD.&#10;Verificación: V-09 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r10" value="R-10 · COMUNICACIONES Y LOCALIZACIÓN&#10;Deberá permitir coordinación con apoyo en superficie y localización según profundidad y estado operativo.&#10;Canal bajo el agua, alcance, tasa de datos, baliza y respuesta a pérdida de enlace: TBD.&#10;Verificación: V-10 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="r11" value="R-11 · MODULARIDAD Y MANTENIMIENTO&#10;Deberá identificar configuraciones e interfaces y permitir mantenimiento con verificación posterior de integridad.&#10;Módulos, uniones, penetraciones, corrosión, tiempo de intervención y pruebas de cierre: TBD.&#10;Verificación: V-11 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="r12" value="R-12 · GEMELA DIGITAL Y TRAZABILIDAD&#10;Deberá vincular modelos de hidrodinámica, estructura, energía y control a configuraciones y datos de validación.&#10;Fidelidad, incertidumbre, sincronización, cobertura y error admisible: TBD.&#10;Verificación: V-12 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="e0" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="Las tarjetas R-01 a R-12 descomponen SYS-00. Todos los requisitos y responsables son propuestos.&#10;La imagen no permite inferir profundidad, resistencia, autonomía ni seguridad. Los límites y criterios se fijarán antes de las pruebas; esta lámina no constituye diseño de fabricación ni autorización de uso tripulado." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1485" width="1720" height="85" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p1" name="02 · Arquitectura simplificada">
