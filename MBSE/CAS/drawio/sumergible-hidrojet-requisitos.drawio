        </mxCell>
        <mxCell id="h0" value="ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="140" width="160" height="60" />
        </mxCell>
        <mxCell id="h1" value="Responsable / método" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="140" width="380" height="60" />
        </mxCell>
        <mxCell id="h2" value="Evidencia de aceptación" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
