        <mxCell id="buoy" value="M-02 · FLOTACIÓN Y RECUPERACIÓN&#10;R-03 / R-08&#10;IF-02: masa, fuerzas y estados&#10;Principio de inmersión y función de emergencia TBD." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="455" width="400" height="180" />
