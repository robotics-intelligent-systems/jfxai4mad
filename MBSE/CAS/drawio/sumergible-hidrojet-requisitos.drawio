        <mxCell id="core" value="INTEGRACIÓN DEL SISTEMA&#10;Configuración · masa/CG · límites · riesgos&#10;R-01 / R-03 / R-08 / R-11" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="275" width="560" height="110" />
        </mxCell>
        <mxCell id="hull" value="M-01 · CARENADO Y ESTRUCTURA&#10;R-02 / R-09 / R-11&#10;IF-01: cargas, cierres y penetraciones&#10;Distinguir envolvente exterior y volumen resistente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="455" width="400" height="180" />
