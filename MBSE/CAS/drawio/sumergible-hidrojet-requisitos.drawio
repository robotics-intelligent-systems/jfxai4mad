        </mxCell>
        <mxCell id="d" value="evalúa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sim" target="core">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="tools" value="CADENA ABIERTA PROPUESTA&#10;FreeCAD: geometría y ensamblajes · Blender: visualización&#10;OpenFOAM: hidrodinámica · OpenModelica: energía y sistemas&#10;Project Chrono: dinámica multicuerpo&#10;Adaptadores y modelos por desarrollar y validar; no se asume interoperabilidad automática." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="925" width="840" height="180" />
        </mxCell>
        <mxCell id="interfaces" value="CONTRATOS DE INTERFAZ (ICD)&#10;Propietario, configuración, uniones y penetraciones, magnitudes y unidades, límites, tolerancias, fallos y ensayos.&#10;Separar datos de ingeniería de funciones críticas.&#10;Los cambios modulares exigen revisar presión/estanqueidad, masa, flotabilidad y recuperación." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="925" width="840" height="180" />
        </mxCell>
        <mxCell id="footer" value="CONFORMIDAD: seleccionar jurisdicción y categoría antes de congelar requisitos. La ruta de validación debe definir revisiones técnicas y campañas no tripuladas previas a cualquier evaluación tripulada." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1160" width="1720" height="100" />
        </mxCell>
      </root>
