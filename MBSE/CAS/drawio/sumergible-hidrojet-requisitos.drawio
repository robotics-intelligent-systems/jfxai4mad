          <mxGeometry as="geometry" x="920" y="455" width="400" height="180" />
        </mxCell>
        <mxCell id="cabin" value="M-04 · HABITÁCULO Y SERVICIOS&#10;R-07 / R-09&#10;IF-04: ambiente, ocupantes y cierres&#10;Régimen de presión y soporte vital TBD." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1360" y="455" width="400" height="180" />
        </mxCell>
        <mxCell id="a" value="define" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="mission" target="core">
