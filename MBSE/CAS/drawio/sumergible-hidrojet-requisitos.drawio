        <mxCell id="b3" value="asignar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="core" target="cabin">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="ctrl" value="M-05 · CONTROL, SENSORES Y COMUNICACIONES&#10;R-06 / R-10 · IF-05: datos, alimentación, alarmas y mando&#10;Estados: superficie → transición → inmersión → retorno.&#10;Modo degradado y recuperación definidos para cada fallo relevante." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="710" width="840" height="150" />
        </mxCell>
        <mxCell id="sim" value="M-06 · GEMELA DIGITAL Y EVIDENCIA&#10;R-12 · IF-06: geometría, parámetros, telemetría y resultados&#10;Modelos versionados por configuración; incertidumbre explícita.&#10;Asistencia de IA para análisis; control autónomo fuera del alcance inicial." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="710" width="840" height="150" />
        </mxCell>
        <mxCell id="c" value="supervisa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ctrl" target="core">
