        </mxCell>
        <mxCell id="v0" value="Responsable: TI + negocio · Aceptación: 100 % de componentes en alcance registrados; exclusiones aprobadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="180" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="RF-02 · Equivalencia funcional&lt;br&gt;Preservar procesos y reglas seleccionados en el destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="Responsable: Dueños de proceso · Aceptación: Todos los escenarios críticos aprobados por usuarios clave." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="240" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="RF-03 · Análisis con Rascal&lt;br&gt;Extraer modelos y detectar dependencias, brechas y ubicaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Responsable: Arquitectura · Aceptación: Cada módulo en alcance tiene análisis o excepción documentada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="RF-04 · Transformación revisable&lt;br&gt;Versionar reglas y mapeos; emitir diagnósticos y artefactos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Responsable: Equipo de migración · Aceptación: Transformaciones reproducibles; revisión y pruebas sin fallos críticos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="360" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="RF-05 · Integridad de datos&lt;br&gt;Preservar relaciones, saldos, identificadores y adjuntos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Responsable: Datos + negocio · Aceptación: Conteos y totales conciliados; tolerancias aprobadas antes del piloto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="420" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="RF-06 · Interoperabilidad&lt;br&gt;Adaptar contratos y autenticación a las versiones reales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="Responsable: Integraciones · Aceptación: Contratos críticos validados; reintentos sin duplicar operaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="480" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="RNF-01 · Seguridad&lt;br&gt;Preservar permisos; proteger secretos y datos durante la migración." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Responsable: Seguridad · Aceptación: Pruebas positivas y negativas de acceso; hallazgos críticos resueltos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="540" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="RNF-02 · Continuidad&lt;br&gt;Planificar corte, respaldo, restauración y reversión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Responsable: Operaciones · Aceptación: Ensayo de restauración/reversión; RTO, RPO y ventana aprobados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="600" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="RNF-03 · Rendimiento&lt;br&gt;Medir carga, latencia y capacidad contra una línea base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Responsable: Operaciones + QA · Aceptación: Umbrales acordados y cumplidos en pruebas representativas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="660" width="750" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="RNF-04 · Plataforma&lt;br&gt;Demostrar compatibilidad de JVM, Rascal y servicios GraalVM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="750" height="54" as="geometry" />
