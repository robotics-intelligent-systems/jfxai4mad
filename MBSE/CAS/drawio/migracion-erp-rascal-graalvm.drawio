        <mxCell id="gov" value="GOBIERNO&lt;br&gt;Validar alcance y brechas&lt;br&gt;Aprobar requisitos y evidencias&lt;br&gt;Resolver cambios y excepciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1140" y="200" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="source" value="ORIGEN · ODOO / FLECTRA&lt;br&gt;Código Python · vistas XML · módulos&lt;br&gt;Datos, adjuntos, reglas e interfaces&lt;br&gt;Inventario de versiones y licencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="rascal" value="RASCAL MPL · CADENA EASY&lt;br&gt;Extraer → analizar → sintetizar&lt;br&gt;Modelo canónico y grafo de dependencias&lt;br&gt;Brechas, reglas de transformación&lt;br&gt;Trazabilidad al archivo y ubicación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="460" y="450" width="610" height="190" as="geometry" />
        </mxCell>
        <mxCell id="target" value="DESTINO PROPUESTO&lt;br&gt;ERP Odoo/Flectra sobre GraalPy&lt;br&gt;Modelo de dominio y PostgreSQL preservados&lt;br&gt;Servicios JVM e interfaces explícitas&lt;br&gt;CPython como alternativa para reversión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1140" y="450" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="ALCANCE PROPUESTO&lt;br&gt;Migrar el runtime seleccionado de Odoo/Flectra a GraalPy, preservar ORM, transacciones, módulos y PostgreSQL. Rascal se incorpora como herramienta propuesta de análisis y transformación; no como requisito ya documentado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f4f8;strokeColor=#7b8899;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1000" height="130" as="geometry" />
        </mxCell>
