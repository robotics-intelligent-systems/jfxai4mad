        <mxCell id="v9" value="Responsable: Arquitectura · Aceptación: Piloto reproducible; GraalPy/Native Image autorizados solo con evidencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
