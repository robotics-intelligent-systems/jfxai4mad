        <mxCell id="subtitle" value="Todos los requisitos son propuestos y pendientes de validación. Cada registro final deberá incluir fuente, prioridad, responsable, versión y evidencia de aceptación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
