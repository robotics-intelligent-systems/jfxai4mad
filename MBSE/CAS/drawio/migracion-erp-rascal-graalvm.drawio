          <mxGeometry x="40" y="200" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="req" value="INGENIERÍA DE REQUISITOS&lt;br&gt;Objetivos → procesos → requisitos&lt;br&gt;Prioridad, responsable, fuente y criterio&lt;br&gt;Línea base y control de cambios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
