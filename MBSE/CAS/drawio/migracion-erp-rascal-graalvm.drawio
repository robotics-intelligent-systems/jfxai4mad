          <mxGeometry x="40" y="25" width="1520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="PROPUESTA PRELIMINAR · 09/10/2026 · Migración del runtime Odoo/Flectra a GraalPy sobre GraalVM según docs/architecture/odoo-graalpy-migration.md. Compatibilidad pendiente de pruebas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1520" height="65" as="geometry" />
