        <mxCell id="title" value="02 · Arquitectura de migración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Diseño propuesto: separar herramientas de transformación, ejecución del ERP y servicios de integración. Todas las compatibilidades deben demostrarse en el piloto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="inventory" value="1 · INVENTARIO Y EXTRACCIÓN&lt;br&gt;Módulos, manifiestos y dependencias&lt;br&gt;Modelos ORM, vistas y permisos&lt;br&gt;psycopg2, lxml, Pillow, xmlsec&lt;br&gt;gevent / pila asíncrona&lt;br&gt;Adaptadores/parsers por desarrollar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="model" value="2 · RASCAL MPL&lt;br&gt;Modelo intermedio tipado&lt;br&gt;Análisis de dependencias y brechas&lt;br&gt;Reglas versionadas y diagnósticos&lt;br&gt;Generación de mapeos, adaptadores&lt;br&gt;y casos de verificación propuestos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="assets" value="3 · ARTEFACTOS REVISADOS&lt;br&gt;Catálogo de requisitos y matriz&lt;br&gt;Mapeos origen–destino&lt;br&gt;Scripts y contratos de integración&lt;br&gt;Plan de pruebas y excepciones&lt;br&gt;Revisión antes de ejecución" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="820" y="220" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="4 · ORQUESTACIÓN / ENSAYO&lt;br&gt;Entorno aislado y carga representativa&lt;br&gt;Arranque y transacciones básicas&lt;br&gt;Validación ORM y concurrencia&lt;br&gt;Conciliación si hay cambios de datos&lt;br&gt;Registro de ejecuciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1200" y="220" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="legacy" value="ERP ORIGEN&lt;br&gt;Runtime existente + BD + adjuntos&lt;br&gt;Respaldo consistente; extracción&lt;br&gt;controlada y corte de escrituras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="java" value="SERVICIOS JVM / POLÍGLOTAS&lt;br&gt;Java, Kotlin o Scala mediante contratos&lt;br&gt;Mensajería y analítica / IA opcionales&lt;br&gt;Rascal en JVM: compatibilidad a probar&lt;br&gt;Native Image: solo trabajadores aislados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="420" y="600" width="730" height="170" as="geometry" />
        </mxCell>
        <mxCell id="erp" value="ERP DESTINO · ODOO/FLECTRA&lt;br&gt;Runtime GraalPy sujeto al piloto&lt;br&gt;ORM + PostgreSQL + adjuntos&lt;br&gt;Preservar módulos y transacciones&lt;br&gt;CPython disponible para reversión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1200" y="600" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cross" value="CONTROLES TRANSVERSALES · Identidad y permisos · secretos · auditoría · observabilidad · copias de seguridad · versiones y licencias&lt;br&gt;Rascal no se presupone lenguaje Truffle. La Polyglot API no implica compatibilidad automática con el ERP ni conversión automática de Python a Java." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=16;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
