        <mxCell id="dec" value="DECISIONES ABIERTAS&lt;br&gt;ADR-01: seleccionar versión/edición de Odoo o Flectra y entorno GraalPy.&lt;br&gt;ADR-02: cerrar inventario Python, extensiones C y bibliotecas del sistema.&lt;br&gt;ADR-03: resolver gevent/async; comparar aislamiento por procesos y workers.&lt;br&gt;ADR-04: demostrar Rascal sobre JVM y definir parsers/reglas de transformación.&lt;br&gt;ADR-05: contratos políglotas y trabajadores Native Image aislados.&lt;br&gt;ADR-06: umbrales de latencia, throughput, memoria, recuperación y contención BD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=16;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
