        </mxCell>
        <mxCell id="r0" value="RF-01 · Inventario y alcance&lt;br&gt;Identificar versión ERP, dependencias Python/nativas, módulos e interfaces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=12;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
