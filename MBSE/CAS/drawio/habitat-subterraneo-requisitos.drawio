    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="03 · Verificación y decisiones">
    <mxGraphModel dx="1900" dy="1570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1570" math="0" shadow="0">
      <root>
