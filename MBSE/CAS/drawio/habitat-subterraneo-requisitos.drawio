          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="tools" value="HERRAMIENTAS ABIERTAS PROPUESTAS&#10;FreeCAD / BIM: geometría y organización del modelo&#10;Blender: visualización · OpenModelica: sistemas y balances&#10;OpenFOAM: estudios de fluidos · EnergyPlus: energía del edificio&#10;Adaptadores y modelos por implementar; intercambio y alcance validados por caso." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="950" width="840" height="185" />
        </mxCell>
        <mxCell id="icd" value="CONTRATO DE INTERFAZ (ICD)&#10;Responsable, uniones, penetraciones, unidades, límites, tolerancias, aislamiento, fallos y pruebas de aceptación.&#10;Cambios modulares: revisar estructura, estanqueidad, evacuación y balances de servicios.&#10;No se asume que un módulo tipo contenedor soporte enterramiento." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="950" width="840" height="185" />
        </mxCell>
        <mxCell id="boundary" value="FRONTERA DEL SISTEMA&#10;Incluye módulos habitables, estructura, envolvente, accesos y servicios internos. Interfaces exteriores: terreno, clima, drenaje, redes, tratamiento/descarga y respuesta de emergencia. Alcance de equipos externos y propiedad por acordar." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1195" width="1720" height="120" />
        </mxCell>
