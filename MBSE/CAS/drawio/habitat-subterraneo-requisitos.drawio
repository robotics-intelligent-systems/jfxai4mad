        </mxCell>
        <mxCell id="twin" value="M-06 · BIM Y GEMELA DIGITAL&#10;R-12 · IF-06: geometría, materiales, parámetros y datos&#10;Evidencia versionada por configuración.&#10;IA para análisis y documentación; funciones críticas con lógica validada." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="730" width="840" height="155" />
