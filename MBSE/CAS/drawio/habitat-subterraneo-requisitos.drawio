        <mxCell id="title" value="VERIFICACIÓN Y CIERRE DE REQUISITOS&#10;Matriz propuesta · Sin valores deducidos de la imagen ni pruebas declaradas como ejecutadas." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
