        <mxCell id="title" value="ARQUITECTURA MODULAR | Funciones e interfaces&#10;Vista simplificada · Las relaciones indican asignación funcional, no un esquema constructivo." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
