<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.4.2" type="device">
  <diagram id="p0" name="01 · Requisitos de alto nivel">
    <mxGraphModel dx="1800" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="HÁBITAT SUBTERRÁNEO MODULAR | Ingeniería de requisitos&#10;Especificación conceptual · Revisión A · Referencia visual suministrada por el usuario" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1720" height="85" />
        </mxCell>
        <mxCell id="basis" value="OBSERVADO EN EL CONCEPTO&#10;Módulos habitables enterrados, acceso por escalera, pozo vertical, espacios técnicos, paneles solares y representación de gemela digital.&#10;La imagen no define dimensiones, materiales ni capacidad resistente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="145" width="840" height="140" />
        </mxCell>
        <mxCell id="decisions" value="DECISIONES ABIERTAS&#10;D-01: ubicación, jurisdicción y uso. D-02: ocupación y autonomía.&#10;D-03: geotecnia, nivel freático y cimentación. D-04: servicios y respaldo. D-05: rutas de evacuación y accesibilidad.&#10;TBD: por definir · TBC: por confirmar." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="145" width="850" height="140" />
        </mxCell>
        <mxCell id="sys" value="SYS-00 · SISTEMA DE INTERÉS&#10;El hábitat deberá integrar espacios de vivienda y servicios en una implantación subterránea verificable, con condiciones de habitabilidad, mantenimiento y evacuación acordes con el uso y sitio aprobados." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="320" width="920" height="110" />
        </mxCell>
        <mxCell id="r1" value="R-01 · USO Y CAPACIDAD&#10;Deberá satisfacer el programa de vivienda y los modos de ocupación aprobados.&#10;Ocupantes, superficie útil [m²], permanencia, accesibilidad y autonomía [h]: TBD.&#10;Verificación: V-01 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r2" value="R-02 · TERRENO Y CIMENTACIÓN&#10;Deberá justificar la implantación y el soporte con datos específicos del emplazamiento.&#10;Suelo, nivel freático, sismicidad, estabilidad de excavación, asentamientos y solución de cimentación: TBD.&#10;Verificación: V-02 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r3" value="R-03 · ESTRUCTURA Y UNIONES&#10;Deberá transmitir las acciones del terreno, agua y uso mediante una estructura y conexiones verificables.&#10;Cargas, materiales, deformaciones, durabilidad, secuencia de montaje y márgenes: TBD.&#10;Verificación: V-03 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="485" width="560" height="225" />
        </mxCell>
        <mxCell id="r4" value="R-04 · AGUA EXTERIOR Y ENVOLVENTE&#10;Deberá limitar entradas de agua y humedad, considerando juntas, penetraciones, drenaje y fallos del sistema.&#10;Presión de agua, estanqueidad, drenaje, bombeo, alarmas y protección ante retorno: TBD.&#10;Verificación: V-04 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r5" value="R-05 · VENTILACIÓN Y AIRE INTERIOR&#10;Deberá proporcionar renovación y calidad del aire para la ocupación y contingencias definidas.&#10;Caudales [m³/h], CO₂, humedad, contaminantes del suelo y radón según sitio: TBD.&#10;Verificación: V-05 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r6" value="R-06 · CONFORT Y HABITABILIDAD&#10;Deberá mantener condiciones térmicas, lumínicas y acústicas compatibles con el uso aprobado.&#10;Temperatura, humedad, iluminación, ruido, condensación y accesibilidad interior: TBD.&#10;Verificación: V-06 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="730" width="560" height="225" />
        </mxCell>
        <mxCell id="r7" value="R-07 · ENERGÍA Y CONTINUIDAD&#10;Deberá alimentar las cargas y priorizar servicios esenciales durante interrupciones.&#10;Fotovoltaica, almacenamiento, red o respaldo, potencia [kW], energía [kWh] y reserva: TBD.&#10;Verificación: V-07 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r8" value="R-08 · AGUA Y SANEAMIENTO&#10;Deberá suministrar agua apta para el uso previsto y gestionar efluentes sin contaminación cruzada.&#10;Origen, calidad, consumo, almacenamiento, tratamiento, descarga y bombeo: TBD.&#10;Verificación: V-08 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r9" value="R-09 · INCENDIO Y EVACUACIÓN&#10;Deberá permitir detección, alerta y salida hacia un lugar seguro en los escenarios definidos.&#10;Rutas, independencia, accesibilidad, compartimentación, humo y tiempos: TBD.&#10;Verificación: V-09 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="975" width="560" height="225" />
        </mxCell>
        <mxCell id="r10" value="R-10 · MODULARIDAD Y MANTENIMIENTO&#10;Deberá permitir inspección, reparación y ampliación con interfaces y configuraciones documentadas.&#10;Dimensiones, conexiones, accesos técnicos, medios de izado y tiempos: TBD.&#10;Verificación: V-10 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="r11" value="R-11 · CONTROL Y SUPERVISIÓN&#10;Deberá supervisar condiciones críticas y permitir operación local definida ante fallos de comunicaciones.&#10;Sensores, alarmas, alimentación, estados degradados, acceso y retención de datos: TBD.&#10;Verificación: V-11 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="r12" value="R-12 · GEMELA DIGITAL&#10;Deberá vincular modelos y datos del hábitat a una configuración y evidencia de validación trazables.&#10;Fidelidad, error admisible, unidades, frecuencia, incertidumbre y versiones: TBD.&#10;Verificación: V-12 · pestaña 03." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1220" width="560" height="225" />
        </mxCell>
        <mxCell id="e0" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="r3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="footer" value="R-01 a R-12 descomponen SYS-00. Requisitos y responsables propuestos; valores y criterios pendientes de definición.&#10;Alcance: vivienda conceptual. No se infiere protección contra explosiones, amenazas químicas o radiación. La ilustración no constituye proyecto constructivo ni evidencia de conformidad." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1485" width="1720" height="90" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p1" name="02 · Arquitectura simplificada">
