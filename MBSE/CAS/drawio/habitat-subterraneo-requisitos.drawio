        <mxCell id="ctrl" value="M-05 · CONTROL Y SUPERVISIÓN&#10;R-11 · IF-05: mediciones, alarmas, mando y alimentación&#10;Operación normal, degradada y emergencia.&#10;Supervisión de inundación, ambiente y energía según riesgos aprobados." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
